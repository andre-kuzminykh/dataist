{
  "name": "ait-card-factory-spec",
  "version": "1.0.0",
  "private": true,
  "description": "Спека + эталоны для фабрики карточек и видео AIT (см. PROMPT.md).",
  "type": "module",
  "scripts": {
    "shots:square": "node render/shots.mjs examples/square_light 3",
    "mp4:square": "node render/mp4.mjs examples/square_light 3",
    "shots:reels": "node render/shots.mjs examples/vertical_dark 3",
    "mp4:reels": "node render/mp4.mjs examples/vertical_dark 3",
    "shots:split": "node render/shots.mjs examples/vertical_split_dark 1",
    "mp4:split": "MP4_T=5000 node render/mp4.mjs examples/vertical_split_dark 1",
    "shots:split-light": "node render/shots.mjs examples/vertical_split_light 1",
    "mp4:split-light": "MP4_T=6000 node render/mp4.mjs examples/vertical_split_light 1"
  },
  "devDependencies": {
    "h264-mp4-encoder": "^1.0.12",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0"
  }
}
